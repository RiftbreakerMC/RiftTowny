<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.riftbreaker</groupId>
    <artifactId>rifttowny-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rifttowny-integrations</artifactId>
  <name>RiftTowny Integrations</name>
  <description>
    The capability registry and one adapter per optional dependency. Every adapter is constructed
    inside its own guard, so a version mismatch in one plugin degrades that one feature instead of
    taking the server down.

    Sibling adapters are added in later phases as the contracts in INTEGRATION_CONTRACTS.md are
    implemented; no adapter is written against an API that has not been read.
  </description>

  <dependencies>
    <dependency>
      <groupId>net.riftbreaker</groupId>
      <artifactId>rifttowny-api</artifactId>
    </dependency>
    <dependency>
      <groupId>net.riftbreaker</groupId>
      <artifactId>rifttowny-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
    </dependency>
    <!--
      RiftEco's API, compiled against and never shaded. provided scope on purpose: the adapter is
      constructed inside a guard and the plugin runs without it, so shipping a copy in the jar would
      mean two RiftEcoService interfaces on the classpath and a ClassCastException on a server that
      has the real one.
    -->
    <dependency>
      <groupId>net.riftbreaker</groupId>
      <artifactId>rifteco</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
    <!--
      PlaceholderAPI. Same rule as RiftEco: compiled against, never shaded, and the expansion is
      constructed inside a guard so a server without PlaceholderAPI loses placeholders and nothing
      else.
    -->
    <dependency>
      <groupId>me.clip</groupId>
      <artifactId>placeholderapi</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      RiftChat's API. Same rule again: compiled against, never shaded, adapter built inside a guard.
      RiftTowny selects a channel's recipients and RiftChat renders the line, which is RiftChat's
      own division of labour rather than one assumed here.
    -->
    <dependency>
      <groupId>net.riftbreaker</groupId>
      <artifactId>riftchat</artifactId>
      <version>0.1.0-rc.1</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
