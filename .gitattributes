# Text sources are pinned to LF so a Windows checkout behaves the same as CI.
# Tests in this organisation read production sources and match against literals
# containing \n, and Flyway checksums its migration files; a CRLF working tree
# breaks both in ways that do not reproduce on Linux.
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.properties text eol=lf
*.md text eol=lf
# The placeholder manifest is a resource a test reads line by line.
*.txt text eol=lf
Jenkinsfile text eol=lf

# These two, or committing them from Windows rewrites the whole file.
.gitignore text eol=lf
.gitattributes text eol=lf

# Leave archives untouched.
*.jar binary
