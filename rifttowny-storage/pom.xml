<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.riftbreaker</groupId>
    <artifactId>rifttowny-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rifttowny-storage</artifactId>
  <name>RiftTowny Storage</name>
  <description>
    JDBC repositories, Flyway migrations, the idempotency store and the transactional outbox.
    One schema over two dialects. Bukkit-free, so the persistence that a duplication or
    double-spend bug would live in is testable against a real database without a server.
  </description>

  <dependencies>
    <dependency>
      <groupId>net.riftbreaker</groupId>
      <artifactId>rifttowny-api</artifactId>
    </dependency>
    <dependency>
      <groupId>net.riftbreaker</groupId>
      <artifactId>rifttowny-domain</artifactId>
    </dependency>

    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- flyway-core carries the SQLite dialect itself, but MySQL/MariaDB needs its own module. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
  </dependencies>
</project>
